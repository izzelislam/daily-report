{
  "name": "dailyreport",
  "version": "0.1.4",
  "private": true,
  "description": "Daily Report - WhatsApp dashboard, API and CLI built on Wacap Wrapper",
  "bin": {
    "dailyreport": "./bin/dailyreport.js"
  },
  "scripts": {
    "dev:api": "tsx watch cli/index.ts server start --foreground",
    "dev:web": "vite --config web/vite.config.mts",
    "build:web": "vite build --config web/vite.config.mts",
    "build:cli": "tsup",
    "build": "npm run build:web && npm run build:cli",
    "start": "node bin/dailyreport.js server start --foreground",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "share": "npm run build && node bin/dailyreport.js server start --foreground --tunnel"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fastify/static": "8.1.0",
    "@whiskeysockets/baileys": "7.0.0-rc.8",
    "better-sqlite3": "^11.8.1",
    "commander": "13.1.0",
    "eventemitter3": "^5.0.1",
    "fastify": "5.2.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.0.9",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "5.5.0",
    "react-router-dom": "7.2.0",
    "tailwindcss": "4.0.9",
    "tsup": "8.4.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "6.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "dist",
    "web/dist"
  ]
}
